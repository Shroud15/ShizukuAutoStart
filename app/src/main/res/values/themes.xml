<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Expressive look: large tonal surfaces, big rounded shapes,
         bold type and spring-driven motion. Dynamic (Material You) colours are
         applied on top on Android 12+. -->
    <style name="Theme.ShizukuAutoStart.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
    </style>

    <style name="Theme.ShizukuAutoStart" parent="Theme.ShizukuAutoStart.Base" />
</resources>

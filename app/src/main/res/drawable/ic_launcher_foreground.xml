<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground layer of the adaptive launcher icon.

    The mark is Shizuku's water-splash silhouette, rebuilt as vector art, lit
    from above and given a soft cast shadow. A complete, bevelled restart ring
    wraps it: this app's job is keeping that service running. The ring is a
    closed circle with a dark outer bevel, a top-to-bottom gradient body, a
    specular highlight along the top and a shade along the inner bottom, so it
    reads as a raised ring rather than a flat outline. Everything stays inside
    the adaptive-icon safe circle, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cast shadow under the restart ring. -->
    <group
        android:translateX="1.4"
        android:translateY="2.2">
        <path
            android:fillColor="#00000000"
            android:pathData="M54,23 A31,31 0 1 1 54,85 A31,31 0 1 1 54,23"
            android:strokeColor="#4D040A1F"
            android:strokeWidth="5" />
    </group>

    <!-- Dark outer bevel of the ring. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,23 A31,31 0 1 1 54,85 A31,31 0 1 1 54,23"
        android:strokeColor="#FF26356F"
        android:strokeWidth="4.4" />

    <!-- Ring body: bright at the top, cooler and deeper at the bottom. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,23 A31,31 0 1 1 54,85 A31,31 0 1 1 54,23"
        android:strokeWidth="3.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="54"
                android:endY="85"
                android:startX="54"
                android:startY="23"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#FFE8EEFF"
                    android:offset="0.45" />
                <item
                    android:color="#FFAFC0F4"
                    android:offset="0.75" />
                <item
                    android:color="#FF7C93E6"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular highlight along the lit top edge. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M23.19,45.74 A31.9,31.9 0 0 1 84.81,45.74"
        android:strokeColor="#D9FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.4" />

    <!-- Shade along the inner bottom edge, so the ring has thickness. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M83.07,61.79 A30.1,30.1 0 0 1 24.93,61.79"
        android:strokeColor="#47000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.4" />

    <!-- Splash mark. -->
    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="25.7"
        android:translateY="-2.2">

        <!-- Soft cast shadow for depth. -->
        <group
            android:translateX="2.6"
            android:translateY="3.2">
            <path
                android:fillColor="#26000000"
                android:fillType="evenOdd"
                android:pathData="M64,57.5a26.52,26.52 0,0 0,-4 -1,25.47 25.47,0 0,0 -9,0.5 25.48,25.48,0 0,0 -9,-5,24.92 24.92,0 0,0 -5,-1 24.8,24.8,0 0,0 -9.5 -10.5A20.55,20.55,0 0,0 21 51a26,26,0 0,0 -11 8c-1.79,2.24 -4.92,6.15 -5,11C4.83,80 17.8,87.15 23,90a51.88,51.88 0 0,0 19 6,15.21 15.21,0 0,0 9,-2c4.38,-2.64 5.92,-6.92 7,-10a27.67,27.67 0 0,0 1,-14,30.15 30.15,0 0,0 4,-8A37.08,37.08 0 0,0 64,57.5ZM28.25,63.25a1.5,1.5 0,1 1,1.5 -1.5A1.5,1.5 0 0 1,28.25 63.25ZM46.75,72a1.5,1.5 0 1,1 1.5 -1.5A1.5,1.5 0 0 1,46.75 72Z" />
        </group>

        <!-- Glass body: bright top, cool periwinkle base. -->
        <path
            android:fillType="evenOdd"
            android:pathData="M64,57.5a26.52,26.52 0,0 0,-4 -1,25.47 25.47,0 0,0 -9,0.5 25.48,25.48,0 0,0 -9,-5,24.92 24.92,0 0,0 -5,-1 24.8,24.8,0 0,0 -9.5 -10.5A20.55,20.55,0 0,0 21 51a26,26,0 0,0 -11 8c-1.79,2.24 -4.92,6.15 -5,11C4.83,80 17.8,87.15 23,90a51.88,51.88 0 0,0 19 6,15.21 15.21,0 0,0 9,-2c4.38,-2.64 5.92,-6.92 7,-10a27.67,27.67 0 0,0 1,-14,30.15 30.15,0 0,0 4,-8A37.08,37.08 0 0,0 64,57.5ZM28.25,63.25a1.5,1.5 0,1 1,1.5 -1.5A1.5,1.5 0 0 1,28.25 63.25ZM46.75,72a1.5,1.5 0 1,1 1.5 -1.5A1.5,1.5 0 0 1,46.75 72Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="30"
                    android:endY="96"
                    android:startX="26"
                    android:startY="32"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0.0" />
                    <item
                        android:color="#FFF3F6FF"
                        android:offset="0.44" />
                    <item
                        android:color="#FFD5DFFF"
                        android:offset="0.78" />
                    <item
                        android:color="#FFB4C4FF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Lit rim. -->
        <path
            android:fillColor="#00000000"
            android:fillType="evenOdd"
            android:pathData="M64,57.5a26.52,26.52 0,0 0,-4 -1,25.47 25.47,0 0,0 -9,0.5 25.48,25.48,0 0,0 -9,-5,24.92 24.92,0 0,0 -5,-1 24.8,24.8,0 0,0 -9.5 -10.5A20.55,20.55,0 0,0 21 51a26,26 0 0,0 -11 8c-1.79,2.24 -4.92,6.15 -5,11C4.83,80 17.8,87.15 23,90a51.88,51.88 0 0,0 19 6,15.21 15.21,0 0,0 9,-2c4.38,-2.64 5.92,-6.92 7,-10a27.67,27.67 0 0,0 1,-14,30.15 30.15 0 0,0 4,-8A37.08,37.08 0 0,0 64,57.5ZM28.25,63.25a1.5,1.5 0 1,1 1.5 -1.5A1.5,1.5 0 0 1,28.25 63.25ZM46.75,72a1.5,1.5 0 1,1 1.5 -1.5A1.5,1.5 0 0 1,46.75 72Z"
            android:strokeColor="#B3FFFFFF"
            android:strokeWidth="1.4" />
    </group>
</vector>
